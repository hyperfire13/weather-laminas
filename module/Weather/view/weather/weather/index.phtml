<!DOCTYPE html>
<html>
<head>
  <title>Weather App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4">
  <div class="container">
    <h1 class="mb-4 text-center">🌦️ Weather Locations</h1>

    <div class="row">
      <?php foreach ($locations as $location): ?>
        <?php 
          try {
            $weather = $this->weatherService->getWeather($location);
        ?>
          <div class="col-md-4 mb-3">
            <div class="card">
              <div class="card-body text-center">
                <h5><?= htmlspecialchars($location) ?></h5>
                <?php if ($weather): ?>
                  <p class="fs-3"><?= round($weather['main']['temp']) ?>°C</p>
                  <p><?= ucfirst($weather['weather'][0]['description']) ?></p>
                  <small class="text-muted">
                    Humidity: <?= $weather['main']['humidity'] ?>%<br>
                    Wind: <?= $weather['wind']['speed'] ?> m/s
                  </small>
                <?php endif; ?>
              </div>
            </div>
          </div>
        <?php 
          } catch (\Exception $e) {
           
          }
        ?>
      <?php endforeach; ?>
    </div>

    <!-- Pagination -->
    <div class="text-center mt-4">
      <nav aria-label="Location pagination">
        <ul class="pagination justify-content-center">
          <!-- Previous Button -->
          <li class="page-item <?= $page <= 1 ? 'disabled' : '' ?>">
            <a class="page-link" href="/weather?page=<?= $page - 1 ?>">
              Previous
            </a>
          </li>

          <!-- Page Numbers -->
          <?php for ($i = 1; $i <= $totalPages; $i++): ?>
            <li class="page-item <?= $page === $i ? 'active' : '' ?>">
              <a class="page-link" href="/weather?page=<?= $i ?>">
                <?= $i ?>
              </a>
            </li>
          <?php endfor; ?>

          <!-- Next Button -->
          <li class="page-item <?= $page >= $totalPages ? 'disabled' : '' ?>">
            <a class="page-link" href="/weather?page=<?= $page + 1 ?>">
              Next
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</body>
</html>